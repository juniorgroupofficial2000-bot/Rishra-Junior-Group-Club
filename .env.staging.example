# STAGING — production-like pre-release
# Example host: https://staging.rishrajuniorgroupclub.in
# Use `next build` + `next start` (NODE_ENV=production, APP_ENV=staging).
# Never use live Razorpay keys or production member dumps.

APP_ENV=staging
NEXT_PUBLIC_APP_ENV=staging
APP_NAME=Rishra Junior Group Club (Staging)
NEXT_PUBLIC_APP_NAME=Rishra Junior Group Club (Staging)
APP_URL=https://staging.rishrajuniorgroupclub.in
NEXT_PUBLIC_APP_URL=https://staging.rishrajuniorgroupclub.in
SITE_URL=https://staging.rishrajuniorgroupclub.in
AUTH_URL=https://staging.rishrajuniorgroupclub.in

AUTH_SECRET=replace-with-staging-secret-min-32-chars

REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://user:pass@staging-db-host:5432/rjgc_staging

PRODUCTION_RESOURCE_MARKERS=rjgc-prod

LOG_LEVEL=info
DEBUG=false

FEATURE_MEMBER_PORTAL=true
FEATURE_PAYMENTS=true
FEATURE_EVENTS=true
FEATURE_PUJA_ARCHIVE=true
FEATURE_GALLERY=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_MEMBERSHIP_APPLICATION=true

PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_staging_xxxxx
EMAIL_FROM="RJGC Staging <noreply@staging.rishrajuniorgroupclub.in>"
# Controlled recipients only — never blast real production members:
EMAIL_RECIPIENT_ALLOWLIST=qa@rjgc.test,@rjgc.test
EMAIL_REDIRECT_TO=staging-inbox@rjgc.test

MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_BUCKET=club-staging
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY_ID=replace-me
MEDIA_S3_SECRET_ACCESS_KEY=replace-me
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=https://media-staging.rishrajuniorgroupclub.in

CRON_SECRET=replace-with-staging-cron-secret-min-32-chars

CONTENT_INCLUDE_SAMPLE=false
ALLOW_DEMO_SEED=false
ALLOW_DESIGN_SYSTEM=false
REQUIRE_STAFF_MFA=true

SENTRY_DSN=https://example@sentry.example/0
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.example/0
ANALYTICS_ENABLED=false
