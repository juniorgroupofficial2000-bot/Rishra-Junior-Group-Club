{
  "name": "rishra-junior-group-club",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration tests/payments",
    "test:security": "vitest run tests/security tests/auth",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "tsx scripts/assert-safe-db.ts && prisma migrate dev",
    "db:migrate:deploy": "tsx scripts/assert-safe-db.ts --deploy && prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "tsx scripts/assert-safe-db.ts --reset && prisma migrate reset",
    "db:seed": "tsx scripts/assert-safe-db.ts && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "prisma": true,
    "esbuild": true,
    "unrs-resolver": true,
    "sharp": true
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.50.0",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
