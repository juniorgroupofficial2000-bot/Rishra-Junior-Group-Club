# MEDIA_S3_BUCKET=
# MEDIA_S3_REGION=
# MEDIA_S3_ENDPOINT=
# MEDIA_S3_ACCESS_KEY_ID=
# MEDIA_S3_SECRET_ACCESS_KEY=
# MEDIA_PUBLIC_BASE_URL=

# Ops
CRON_SECRET=jlnSKqY1XZ/roU8YEeLRwh5cvOUiAzfXRr2SR/DjLr8=

# Monitoring (optional)
