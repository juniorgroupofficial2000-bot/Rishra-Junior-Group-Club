# ─── Rishra Junior Group Club — environment contract ─────────────────────────
# Copy the matching template for your lane:
#   .env.local.example        → LOCAL developer machine
#   .env.development.example  → shared DEVELOPMENT
#   .env.staging.example      → STAGING
#   .env.production.example   → PRODUCTION
#
# Never commit real secrets. See docs/environments.md.
#
# Prefer reading configuration via `@/config` — do not scatter process.env reads.

# Logical lane (local | development | staging | production)
APP_ENV=local
APP_NAME=Rishra Junior Group Club
APP_URL=https://rishra-junior-group-club.vercel.app

# Browser-visible mirrors (must match APP_* when set)
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_NAME=Rishra Junior Group Club
NEXT_PUBLIC_APP_URL=https://rishra-junior-group-club.vercel.app

# Legacy aliases (still supported)
SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Auth
AUTH_SECRET=HB4K6q6z1eCm14ikpeDD/KNpP99Yny9KXqirv4sx618=

# Database
REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://user:pass@localhost:5432/rjgc_local

# Comma-separated markers that non-production lanes must not match
# PRODUCTION_RESOURCE_MARKERS=rjgc-prod,rishrajuniorgroupclub.in

# Logging
LOG_LEVEL=debug
# DEBUG=false

# Feature flags
FEATURE_MEMBER_PORTAL=true
FEATURE_PAYMENTS=true
FEATURE_EVENTS=true
FEATURE_PUJA_ARCHIVE=true
FEATURE_GALLERY=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_MEMBERSHIP_APPLICATION=true

# Payments (never use NEXT_PUBLIC_* for secrets)
PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
# ALLOW_MOCK_PAYMENTS=true
# MOCK_PAYMENTS_CONFIRM=I_UNDERSTAND_NO_REAL_MONEY
# PAYMENT_WEBHOOK_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Email
# EMAIL_PROVIDER=console
# RESEND_API_KEY=
# EMAIL_FROM=

# Media
MEDIA_STORAGE_DRIVER=local
