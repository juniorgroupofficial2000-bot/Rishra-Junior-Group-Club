# PRODUCTION — real members
# Example host: https://rishrajuniorgroupclub.in
# NODE_ENV=production and APP_ENV=production.
# Never enable demo/sample/E2E flags. Never use test Razorpay keys.

APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
APP_NAME=Rishra Junior Group Club
NEXT_PUBLIC_APP_NAME=Rishra Junior Group Club
APP_URL=https://rishrajuniorgroupclub.in
NEXT_PUBLIC_APP_URL=https://rishrajuniorgroupclub.in
SITE_URL=https://rishrajuniorgroupclub.in
AUTH_URL=https://rishrajuniorgroupclub.in

AUTH_SECRET=replace-with-production-csprng-secret-min-32

REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://user:pass@prod-db-host:5432/rjgc_production

LOG_LEVEL=warn
DEBUG=false

FEATURE_MEMBER_PORTAL=true
FEATURE_PAYMENTS=true
FEATURE_EVENTS=true
FEATURE_PUJA_ARCHIVE=true
FEATURE_GALLERY=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_MEMBERSHIP_APPLICATION=true

PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=live
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EMAIL_PROVIDER=resend
RESEND_API_KEY=re_live_xxxxx
EMAIL_FROM="Rishra Junior Group Club <noreply@rishrajuniorgroupclub.in>"
# Do not set EMAIL_REDIRECT_TO or EMAIL_RECIPIENT_ALLOWLIST in production.

MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_BUCKET=club-production
MEDIA_S3_REGION=auto
MEDIA_S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
MEDIA_S3_ACCESS_KEY_ID=replace-me
MEDIA_S3_SECRET_ACCESS_KEY=replace-me
MEDIA_S3_FORCE_PATH_STYLE=true
MEDIA_PUBLIC_BASE_URL=https://media.rishrajuniorgroupclub.in

CRON_SECRET=replace-with-production-cron-secret-min-32

CONTENT_INCLUDE_SAMPLE=false
ALLOW_DEMO_SEED=false
ALLOW_DESTRUCTIVE_OPS=false
ALLOW_DESIGN_SYSTEM=false
REQUIRE_STAFF_MFA=true
E2E_TEST=0

SENTRY_DSN=https://example@sentry.example/0
NEXT_PUBLIC_SENTRY_DSN=https://example@sentry.example/0
ANALYTICS_ENABLED=true

CONTACT_PUBLIC_EMAIL=contact@rishrajuniorgroupclub.in
# CONTACT_PUBLIC_PHONE=
# CONTACT_PUBLIC_HOURS=
