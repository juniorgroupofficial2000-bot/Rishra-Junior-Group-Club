# Copy to .env.local for development. Never commit real secrets.

# Required in production (min 32 characters). Used to sign Auth.js JWTs/cookies.
AUTH_SECRET=

# Public site origin for canonical URLs, sitemap, Open Graph, and JSON-LD.
# Do not invent a production domain — set the real deployment URL.
SITE_URL=http://localhost:3000
# Optional browser-visible alias (prefer SITE_URL for server code).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Persistence driver: mock | prisma
REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rjgc

# Payments: mock (local/sandbox) | razorpay
PAYMENT_PROVIDER=mock
# Required when PAYMENT_PROVIDER=mock in production, or set ALLOW_MOCK_PAYMENTS=true
PAYMENT_WEBHOOK_SECRET=
# ALLOW_MOCK_PAYMENTS=true
PAYMENT_MODE=test

# Razorpay (required when PAYMENT_PROVIDER=razorpay — no silent mock fallback)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
