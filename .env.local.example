# LOCAL — developer machine only
# Copy to `.env.local` or `.env` for `next dev`.
# Never point DATABASE_URL at production.

APP_ENV=local
NEXT_PUBLIC_APP_ENV=local
APP_NAME=Rishra Junior Group Club
NEXT_PUBLIC_APP_NAME=Rishra Junior Group Club
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
SITE_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

AUTH_SECRET=local-dev-auth-secret-change-me-32chars

REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://user:pass@localhost:5432/rjgc_local

# Refuse accidental prod resources if these substrings appear
# (merged with built-in defaults: club-production, rjgc_production, …)
PRODUCTION_RESOURCE_MARKERS=rjgc-prod,rishrajuniorgroupclub.in
# ALLOW_REMOTE_LOCAL_DATABASE=false
# ALLOW_DESTRUCTIVE_OPS=false

LOG_LEVEL=debug
DEBUG=true

FEATURE_MEMBER_PORTAL=true
FEATURE_PAYMENTS=true
FEATURE_EVENTS=true
FEATURE_PUJA_ARCHIVE=true
FEATURE_GALLERY=true
FEATURE_ANNOUNCEMENTS=true
FEATURE_MEMBERSHIP_APPLICATION=true

PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
ALLOW_MOCK_PAYMENTS=true
MOCK_PAYMENTS_CONFIRM=I_UNDERSTAND_NO_REAL_MONEY
PAYMENT_WEBHOOK_SECRET=local-mock-webhook-secret

EMAIL_PROVIDER=console

MEDIA_STORAGE_DRIVER=local
MEDIA_LOCAL_ROOT=.data/media

CRON_SECRET=local-cron-secret-for-dev-only-32bxx

CONTENT_INCLUDE_SAMPLE=false
ALLOW_DEMO_SEED=false
ALLOW_DESIGN_SYSTEM=true
REQUIRE_STAFF_MFA=false
