# Copy to .env.local for development. Never commit real secrets.

# --- Required in production ---
# Min 32 characters. Signs Auth.js JWTs/cookies.
AUTH_SECRET=

# Public HTTPS origin for canonical URLs, sitemap, Open Graph, JSON-LD.
# Do not invent a domain in code — set the real deployment URL.
SITE_URL=http://localhost:3000
# AUTH_URL=https://your-real-domain.example

# Persistence: production MUST be prisma (mock is fail-closed in production).
REPOSITORY_DRIVER=prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/rjgc

# Payments: production MUST be razorpay for real money.
PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
PAYMENT_WEBHOOK_SECRET=

# Razorpay (required when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Dangerous overrides (sandbox only) ---
# ALLOW_MOCK_PAYMENTS=true
# MOCK_PAYMENTS_CONFIRM=I_UNDERSTAND_NO_REAL_MONEY
# ALLOW_DEMO_SEED=true
# CONTENT_INCLUDE_SAMPLE=true
# ALLOW_DESIGN_SYSTEM=true

# Optional browser-visible site URL alias (prefer SITE_URL).
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
